{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rappidAI-Research/lumen-quantum/schemas/echelon-calibration-report.schema.json",
  "title": "Quantum 1 Echelon 1B calibration report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "code_revision",
    "model_config_sha256",
    "tokenizer_checksum",
    "data_manifest_id",
    "processed_tokens",
    "tokens_per_second",
    "peak_vram_gib",
    "checkpoint_seconds",
    "purchase_option",
    "instance_type",
    "region",
    "price_usd_per_hour",
    "cost_per_billion_tokens_usd",
    "projected_40b_cost_usd",
    "resume_test_passed",
    "client_disconnect_test_passed",
    "verification_status"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "code_revision": { "type": "string" },
    "model_config_sha256": { "type": "string" },
    "tokenizer_checksum": { "type": "string" },
    "data_manifest_id": { "type": "string" },
    "processed_tokens": { "type": "integer", "minimum": 1 },
    "tokens_per_second": { "type": "number", "exclusiveMinimum": 0 },
    "peak_vram_gib": { "type": "number", "exclusiveMinimum": 0 },
    "checkpoint_seconds": { "type": "number", "minimum": 0 },
    "purchase_option": { "enum": ["spot", "on-demand"] },
    "instance_type": { "type": "string" },
    "region": { "type": "string" },
    "price_usd_per_hour": { "type": "number", "exclusiveMinimum": 0 },
    "cost_per_billion_tokens_usd": { "type": "number", "exclusiveMinimum": 0 },
    "projected_40b_cost_usd": { "type": "number", "exclusiveMinimum": 0 },
    "resume_test_passed": { "type": "boolean" },
    "client_disconnect_test_passed": { "type": "boolean" },
    "verification_status": { "enum": ["measured", "invalid"] }
  }
}
