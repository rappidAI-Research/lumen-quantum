# Copy to /etc/rappidai/quantum-1-echelon-<run-name>.env on the AWS host.
# Keep this file free of AWS keys. Use the EC2 instance role for S3 access.

ECHELON_RUN_ID=quantum-1-echelon-smoke
ECHELON_STATUS_PATH=/var/lib/rappidai/quantum-1-echelon/run-status.json
ECHELON_LOG_PATH=/var/lib/rappidai/quantum-1-echelon/train.log
ECHELON_MAX_SECONDS=3600

# JSON array; no shell parsing is used.
# Replace this bounded smoke command only after the production trainer is frozen.
ECHELON_CHILD_JSON=["/opt/rappidai/lumen-quantum/.venv/bin/python","scripts/echelon_base_smoke.py","--config","configs/echelon/1b/smoke-tiny.yaml","--manifest","/mnt/echelon/smoke/manifest.json","--output-dir","/mnt/echelon/smoke/run","--run-id","quantum-1-echelon-smoke","--max-steps","2"]
